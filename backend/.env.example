# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# PostgreSQL Database
# Railway provides DATABASE_URL automatically when linking a PostgreSQL service.
# For Supabase, set DATABASE_URL from the Supabase connection pooler.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Cloudflare R2 / S3-compatible Storage for Abstract PDFs
# You can use either R2_* or legacy SUPABASE_STORAGE_* variable names
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=noet-2027-abstracts
R2_REGION=auto
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com


# Optional email configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NOET 2027 <no-reply@example.com>
